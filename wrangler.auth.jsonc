{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subject-advisors-p004-local",
  "main": "tools/auth/local/api.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  },
  "vars": {
    "CLERK_AUTHORIZED_PARTIES": "http://127.0.0.1:5173,http://localhost:5173"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}