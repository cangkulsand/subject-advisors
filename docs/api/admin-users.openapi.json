{
  "openapi": "3.1.0",
  "info": {
    "title": "Subject Advisors admin user management API",
    "version": "1.0.0",
    "description": "SYSTEM_ADMIN-only mutations for application accounts, roles, access status and invitations (S2-P004-004). Every route requires a Clerk bearer token and an active SYSTEM_ADMIN with an eligible verified email. The acting administrator is always taken from the verified session, never from the body. Mutation bodies must be application/json, at most 16 KB, and must contain no unknown fields. All responses are Cache-Control: no-store. Delete means suspend: there is no hard delete. Existing read routes (GET /api/admin/overview, /users, /users/{id}, /audit) are unchanged; an unsupported method on a known path returns 405 with an Allow header."
  },
  "servers": [
    {
      "url": "https://subject-advisors.example"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/admin/users": {
      "post": {
        "operationId": "createAdminAccount",
        "summary": "Add an application account for an existing Clerk user",
        "description": "Looks the user up by exact primary email. The email must be verified and eligible for every requested role (STUDENT: verified @graduate.utm.my; COORDINATOR and SYSTEM_ADMIN: verified @utm.my). reason is trimmed, 1-500 characters, and is stored in the audit log.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccountRequest"
              },
              "example": {
                "email": "ali@utm.my",
                "roles": [
                  "COORDINATOR"
                ],
                "reason": "Appointed programme coordinator"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDetailEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, body over 16 KB, unknown field, invalid id or a failed validator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "INVALID_REQUEST",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or revoked Clerk session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "SESSION_INVALID",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "403": {
            "description": "Caller is not an active, eligible SYSTEM_ADMIN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "ROLE_DENIED",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "404": {
            "description": "No matching Clerk user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "CLERK_USER_NOT_FOUND",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "409": {
            "description": "Business rule violation. Stable codes: ACCOUNT_EXISTS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type is not application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "UNSUPPORTED_MEDIA_TYPE",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "422": {
            "description": "Email unverified or not eligible for a requested role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "ROLE_NOT_ELIGIBLE",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "503": {
            "description": "Database or identity provider unavailable (no internal text is returned)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "ADMIN_UNAVAILABLE",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/users/{id}/roles": {
