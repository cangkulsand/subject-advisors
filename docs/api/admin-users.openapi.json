      }
    },
    "/api/admin/invitations/{id}": {
      "delete": {
        "operationId": "revokeAdminInvitation",
        "summary": "Revoke a pending invitation",
        "description": "Marks the database row REVOKED (it can then never be redeemed) and, best effort, revokes the Clerk invitation. reason is trimmed, 1-500 characters, and is stored in the audit log.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReasonRequest"
              },
              "example": {
                "reason": "Sent to the wrong person"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Revoked invitation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, body over 16 KB, unknown field, invalid id or a failed validator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "INVALID_REQUEST",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or revoked Clerk session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "SESSION_INVALID",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "403": {
            "description": "Caller is not an active, eligible SYSTEM_ADMIN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "ROLE_DENIED",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Business rule violation. Stable codes: NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Business rule violation. Stable codes: INVITATION_NOT_PENDING, INVITATION_EXPIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type is not application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "UNSUPPORTED_MEDIA_TYPE",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "503": {
            "description": "Database or identity provider unavailable (no internal text is returned)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "ADMIN_UNAVAILABLE",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Role": {
        "type": "string",
        "enum": [
          "STUDENT",
          "COORDINATOR",
          "SYSTEM_ADMIN"
        ]
      },
      "InvitationStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "ACCEPTED",
          "REVOKED",
          "EXPIRED"
        ]
      },
      "Reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "description": "Trimmed before validation; stored in the audit log."
      },
      "Email": {
        "type": "string",
        "maxLength": 254,
        "description": "Trimmed and lower-cased."
      },
      "Roles": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "uniqueItems": true,
        "items": {
          "$ref": "#/components/schemas/Role"
        }
      },
      "ReasonRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "$ref": "#/components/schemas/Reason"
          }
        }
      },
      "CreateAccountRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "roles",
          "reason"
        ],
        "properties": {
          "email": {
            "$ref": "#/components/schemas/Email"
          },
          "roles": {
            "$ref": "#/components/schemas/Roles"
          },
          "reason": {
            "$ref": "#/components/schemas/Reason"
          }
        }
      },
      "CreateInvitationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "roles",
          "reason"
        ],
        "properties": {
          "email": {
            "$ref": "#/components/schemas/Email"
          },
          "roles": {
            "$ref": "#/components/schemas/Roles"
          },
          "reason": {
            "$ref": "#/components/schemas/Reason"
          }
        }
      },
      "GrantRoleRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "reason"
        ],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "reason": {
            "$ref": "#/components/schemas/Reason"
          }
        }
      },
      "ChangeAccessRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "reason"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          },
          "reason": {
            "$ref": "#/components/schemas/Reason"
          }
        }
      },
      "Identity": {
        "type": "object",
        "required": [
          "state",
          "name",
          "email",
          "emailVerified"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "available",
              "not_found",
              "unavailable"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "emailVerified": {
            "type": "boolean"
          }
        }
      },
      "Membership": {
        "type": "object",
        "required": [
          "role",
          "emailPolicy",
          "source",
          "protectedOwner",
          "reason",
          "grantedAt"
        ],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "emailPolicy": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "protectedOwner": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "grantedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AccountDetail": {
        "type": "object",
        "required": [
          "accountId",
          "clerkUserId",
          "roles",
          "accessStatus",
          "protectedOwner",
          "createdAt",
          "updatedAt",
          "identity",
          "memberships"
        ],
        "properties": {
          "accountId": {
            "type": "integer"
          },
          "clerkUserId": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "accessStatus": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          },
          "protectedOwner": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "identity": {
            "$ref": "#/components/schemas/Identity"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          }
        }
      },
      "AccountDetailEnvelope": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AccountDetail"
          }
        }
      },
      "Invitation": {
        "type": "object",
        "required": [
          "id",
          "email",
          "roles",
          "status",
          "invitedBy",
          "reason",
          "createdAt",
          "expiresAt",
          "acceptedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "roles": {
            "$ref": "#/components/schemas/Roles"
          },
          "status": {
            "$ref": "#/components/schemas/InvitationStatus"
          },
          "invitedBy": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "acceptedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "InvitationEnvelope": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Invitation"
          }
        }
      },
      "InvitationPageEnvelope": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "items",
              "total",
              "page",
              "pageSize",
              "generatedAt"
            ],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Invitation"
                }
              },
              "total": {
                "type": "integer"
              },
              "page": {
                "type": "integer"
              },
              "pageSize": {
                "type": "integer",
                "const": 20
              },
              "generatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string",
                "description": "Fixed safe text; never SQL, provider or credential details."
              }
            }
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable error codes.",
        "enum": [
          "SESSION_INVALID",
          "ROLE_DENIED",
          "EMAIL_DOMAIN_DENIED",
          "ACCOUNT_SUSPENDED",
          "INVALID_REQUEST",
          "INVALID_JSON",
          "BODY_TOO_LARGE",
          "UNSUPPORTED_MEDIA_TYPE",
          "INVALID_ADMIN_QUERY",
          "METHOD_NOT_ALLOWED",
          "ADMIN_ROUTE_NOT_FOUND",
          "ADMIN_UNAVAILABLE",
          "ROLE_ALREADY_ASSIGNED",
          "LAST_ACTIVE_ADMIN",
          "PROTECTED_OWNER",
          "SELF_LOCKOUT",
          "ROLE_NOT_ELIGIBLE",
          "ACCOUNT_EXISTS",
          "CLERK_USER_EXISTS",
          "CLERK_USER_NOT_FOUND",
          "INVITATION_EXISTS",
          "LAST_ROLE",
          "INVITATION_DELIVERY_FAILED",
          "NOT_FOUND",
          "ROLE_NOT_ASSIGNED",
          "INVITATION_NOT_PENDING",
          "INVITATION_EXPIRED",
          "CONFLICT",
          "MUTATION_FAILED"
        ]
      }
    }
  }
}
