            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "UNSUPPORTED_MEDIA_TYPE",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "422": {
            "description": "Target email is not eligible for the role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "ROLE_NOT_ELIGIBLE",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "503": {
            "description": "Database or identity provider unavailable (no internal text is returned)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "ADMIN_UNAVAILABLE",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          }
        }
      }
    },
