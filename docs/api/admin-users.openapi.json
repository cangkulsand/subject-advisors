      "post": {
        "operationId": "createAdminInvitation",
        "summary": "Invite someone who has not signed up yet",
        "description": "Roles must be eligible for the invited email domain. Order: database row (PENDING, expires in 7 days), then the Clerk email invitation (expiresInDays 7), then the Clerk reference is attached. If Clerk fails the row is revoked and 503 INVITATION_DELIVERY_FAILED is returned. If the email already belongs to a Clerk user with an application account the result is 409 ACCOUNT_EXISTS; if it belongs to a Clerk user without an application account the result is 409 CLERK_USER_EXISTS (use POST /api/admin/users instead). At first sign-in (POST /api/me/initialize) the invitation is redeemed only if the VERIFIED primary email equals the invited email and the roles are still eligible for it; otherwise normal student self-registration applies. reason is trimmed, 1-500 characters, and is stored in the audit log.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvitationRequest"
              },
              "example": {
                "email": "new.staff@utm.my",
                "roles": [
                  "COORDINATOR"
                ],
                "reason": "New coordinator for 2026/27"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invitation created and emailed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, body over 16 KB, unknown field, invalid id or a failed validator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "INVALID_REQUEST",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or revoked Clerk session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "SESSION_INVALID",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "403": {
            "description": "Caller is not an active, eligible SYSTEM_ADMIN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "ROLE_DENIED",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "409": {
            "description": "Business rule violation. Stable codes: ACCOUNT_EXISTS, CLERK_USER_EXISTS, INVITATION_EXISTS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type is not application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "UNSUPPORTED_MEDIA_TYPE",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "422": {
            "description": "Roles not eligible for the invited email domain",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "ROLE_NOT_ELIGIBLE",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "503": {
            "description": "INVITATION_DELIVERY_FAILED (Clerk could not send the email) or ADMIN_UNAVAILABLE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "error": {
                    "code": "INVITATION_DELIVERY_FAILED",
                    "message": "See the error code catalogue."
