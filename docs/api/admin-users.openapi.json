    "/api/admin/invitations": {
      "get": {
        "operationId": "listAdminInvitations",
        "summary": "List invitations (20 per page, newest first)",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/InvitationStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invitation page. Lapsed pending rows read as EXPIRED.",
