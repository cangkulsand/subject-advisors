                },
                "example": {
                  "error": {
                    "code": "SESSION_INVALID",
                    "message": "See the error code catalogue."
                  }
                }
              }
            }
          },
          "403": {
            "description": "Caller is not an active, eligible SYSTEM_ADMIN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
