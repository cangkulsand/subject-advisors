{
  "openapi": "3.0.3",
  "info": { "title": "Subject Advisors multi-role account API", "version": "1.1.0", "description": "Additive account contract. Roles are explicit database grants; availableRoles is their verified-email-eligible subset. appRole/profileState/landingPath remain default-view compatibility fields. UI navigation never grants API access." },
  "servers": [{ "url": "https://subject-advisors.example" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api/me": { "get": { "operationId": "getAccountAccess", "summary": "Read current account access", "responses": {
      "200": { "description": "Active account with at least one eligible explicitly granted role. No-store response.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountEnvelope" }, "example": { "data": { "clerkUserId": "user_fixture", "appRole": "STUDENT", "roles": ["STUDENT", "COORDINATOR", "SYSTEM_ADMIN"], "availableRoles": ["STUDENT", "COORDINATOR", "SYSTEM_ADMIN"], "accessStatus": "ACTIVE", "studentProfileState": "COMPLETE", "profileState": "COMPLETE", "landingPath": "/student" } } } } },
      "401": { "description": "Missing, expired or revoked Clerk session" },
      "403": { "description": "Unassigned or suspended account, unverified primary email, or no domain-eligible granted role" },
      "503": { "description": "Identity, role store, migration or provider unavailable; access fails closed" }
    } } },
    "/api/me/initialize": { "post": { "operationId": "initializeStudentAccount", "summary": "Initialize a new eligible student only", "description": "Empty body only. A verified graduate.utm.my primary email can create STUDENT access once. Existing role grants and suspension are preserved. This endpoint never grants staff roles.", "responses": {
      "200": { "description": "Current active account", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccountEnvelope" } } } },
      "400": { "description": "Request body supplied" }, "401": { "description": "Invalid session" }, "403": { "description": "Registration or account access denied" }, "503": { "description": "Dependency unavailable" }
    } } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "Role": { "type": "string", "enum": ["STUDENT", "COORDINATOR", "SYSTEM_ADMIN"] },
      "ProfileState": { "type": "string", "enum": ["COMPLETE", "SETUP_REQUIRED", "UNAVAILABLE", "NOT_APPLICABLE"] },
      "AccountEnvelope": { "type": "object", "required": ["data"], "properties": { "data": { "type": "object", "required": ["clerkUserId", "appRole", "roles", "availableRoles", "accessStatus", "studentProfileState", "profileState", "landingPath"], "properties": {
        "clerkUserId": { "type": "string" }, "appRole": { "$ref": "#/components/schemas/Role" },
        "roles": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/components/schemas/Role" } },
        "availableRoles": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/components/schemas/Role" } },
        "accessStatus": { "type": "string", "enum": ["ACTIVE"] },
        "studentProfileState": { "$ref": "#/components/schemas/ProfileState" }, "profileState": { "$ref": "#/components/schemas/ProfileState" },
        "landingPath": { "type": "string", "enum": ["/student", "/student/setup", "/coordinator", "/admin"] }
      } } } }
    }
  }
}
